# Copie para .env e carregue no shell antes de iniciar, se necessário.
# Nunca adicione o arquivo .env com valores reais ao Git.
# Opcional: por padrão os dados ficam em .tcc-data dentro do projeto.
# TCC_DATA_DIR=/caminho/gravavel/para/os/dados
# O modo auto usa Supabase quando o PAT existe; sem configuração remota, SQLite.
TCC_STORAGE_BACKEND=auto
# Projeto público vinculado também está em supabase/project.json.
# SUPABASE_PROJECT_REF=dcfcxrvjkvppulhhxvoq
# Cadastre SUPABASE_ACCESS_TOKEN como segredo no servidor/Codespaces.
# Não cole o valor em arquivos versionados nem no frontend.
TCC_LLM_BASE_URL=https://api.openai.com/v1
TCC_LLM_MODEL=gpt-4o-mini
# Opcional. Sem chave, M1/M2 e A1 continuam disponíveis.
# TCC_LLM_API_KEY=
